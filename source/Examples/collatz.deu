// Collatz-Vermutung: Halbiere gerade Zahlen, rechne bei ungeraden 3n + 1.
// Irgendwann landet man (vermutlich) immer bei 1.

zahl start = 27;
zahl n = start;
zahl schritte = 0;
zahl maximum = n;

solange n != 1 {
    wenn n % 2 == 0 {
        n = n / 2;
    } sonst {
        n = 3 * n + 1;
    }
    wenn n > maximum {
        maximum = n;
    }
    schritte = schritte + 1;
}

schreibe "Start: " + start;
schreibe "Schritte bis 1: " + schritte;
schreibe "Höchster Wert unterwegs: " + maximum;
